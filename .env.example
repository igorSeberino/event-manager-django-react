# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Os valores abaixo são padrões de DESENVOLVIMENTO. NÃO use em produção.

# Django
SECRET_KEY=dev-secret-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL
# DB_HOST=db é o nome do serviço no docker-compose (use 127.0.0.1 fora do Docker).
DB_NAME=event_manager
DB_USER=event_user
DB_PASSWORD=event_pass
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root_pass
